# Copy this file to .env and fill in your keys.
# Primary provider key (Mistral by default)
MISTRAL_API_KEY=

# Optional: use OpenAI instead (set AI_PROVIDER=openai)
# OPENAI_API_KEY=
# AI_PROVIDER=mistral

# Optional: override the backend port (defaults to the value passed by the app)
# NULLDRAFT_PORT=8000
