# Copy this file to .env and fill in your keys.
# Primary provider key (Mistral by default)
MISTRAL_API_KEY=

# Choose one provider: mistral, openai, anthropic, or gemini.
# The desktop app normally supplies the selected API key automatically.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AI_PROVIDER=mistral

# Optional: override the backend port (defaults to the value passed by the app)
# NULLDRAFT_PORT=8011
