# Direct Python run: point this to your PostgreSQL instance.
DATABASE_URL=postgresql://nulldraft:change-me@localhost:5432/nulldraft
# Docker Compose uses these to build its database URL.
POSTGRES_DB=nulldraft
POSTGRES_USER=nulldraft
POSTGRES_PASSWORD=change-me
NULLDRAFT_ENV=development
NULLDRAFT_ADMIN_EMAILS=your@email.com
# Required only to create the first administrator invitation. Use a long random value.
NULLDRAFT_BOOTSTRAP_SECRET=change-this-to-a-long-random-secret
# Required to sign in to the browser-based /admin console. Use a different,
# long random value and store it only in your deployment's secret variables.
NULLDRAFT_ADMIN_CONSOLE_PASSWORD=change-this-to-a-long-random-password
NULLDRAFT_PUBLIC_URL=https://api.example.com
NULLDRAFT_CLOUD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
