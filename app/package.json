{
  "name": "nulldraft",
  "version": "0.1.1",
  "description": "AI-powered desktop application that turns instructions into step-by-step screenshot documentation",
  "author": "Edder <edder@example.com>",
  "homepage": "https://github.com/simoderyouch/NullDraft",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:no-sandbox": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "build": "electron-vite build",
    "build:release": "node scripts/assert-release-config.mjs && electron-vite build",
    "prepare:win-backend": "node scripts/prepare-windows-backend.mjs",
    "preview": "electron-vite preview",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "build:linux": "npm run build:release && ELECTRON_BUILDER_CACHE=build/.electron-builder-cache electron-builder --linux AppImage",
    "build:deb": "npm run build:release && ELECTRON_BUILDER_CACHE=build/.electron-builder-cache electron-builder --linux deb",
    "build:win": "npm run prepare:win-backend && npm run build:release && electron-builder --win"
  },
  "build": {
    "appId": "com.nulldraft.app",
    "productName": "NullDraft",
    "directories": {
      "output": "dist"
    },
    "compression": "store",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "nulldraft",
      "icon": "build/icons",
      "category": "Office",
      "maintainer": "Edder <edder@example.com>",
      "desktop": {
        "entry": {
          "StartupWMClass": "nulldraft"
        }
      }
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icons/512x512.png"
    },
    "files": [
      "out/**/*",
      "package.json",
      "build/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!venv/**",
          "!.venv/**",
          "!__pycache__/**",
          "!**/__pycache__/**",
          "!.env",
          "!test_*.py",
          "!*.log"
        ]
      },
      {
        "from": "build/python-win",
        "to": "python"
      },
      {
        "from": "build/icons",
        "to": "icons"
      }
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cropperjs": "^2.1.1",
    "dbus-next": "^0.10.2",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-cropper": "^2.3.3",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "screenshot-desktop": "^1.15.4",
    "tailwind-merge": "^2.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "@playwright/test": "^1.55.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
